{
  "$schema": "https://raw.githubusercontent.com/DonIsaac/zlint/refs/tags/v0.10.0/zlint.schema.json",
  "ignore": [
    "**/*.mixin.zig",
    "**/*.replace.zig",
    "src/class/*",
    "src/builtin/*",
    "src/global/*"
  ],
  "rules": {
    "gdzig-imports-sorted": [
      "warn",
      {
        "std_modules": [
          "std",
          "builtin"
        ]
      }
    ],
    "gdzig-imports-location": [
      "warn",
      {
        "position": "bottom"
      }
    ],
    "gdzig-file-name-case": "warn",
    "gdzig-import-alias-case": "warn",
    "gdzig-tests-last": "warn",
    "homeless-try": "error",
    "no-unresolved": "off",
    "unused-decls": "off",
    "unsafe-undefined": "off",
    "avoid-as": "off",
    "no-print": "off",
    "suppressed-errors": "off",
    "line-length": "off",
    "empty-file": "off"
  }
}
